<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cyber_cat</name>
  <version>0.1.0</version>
  <description>Vision-only air-ground pursuit: a TurtleBot 4 chases a Crazyflie</description>
  <maintainer email="zong.s@northeastern.edu">Sujie Zong</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Create 3 light ring. Optional: the nodes degrade gracefully without it,
       which is what lets the same package run headless in simulation. -->
  <exec_depend>irobot_create_msgs</exec_depend>

  <!-- Ignition Gazebo simulation only -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
